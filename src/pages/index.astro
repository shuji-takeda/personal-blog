---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import AdSlot from '../components/AdSlot.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
const techCount = allPosts.filter((p) => p.data.category === 'tech').length;
const otherCount = allPosts.filter((p) => p.data.category === 'other').length;
---

<BaseLayout title="ホーム">
  <!-- ヒーローセクション -->
  <section class="mb-10 text-center sm:text-left sm:flex sm:items-center sm:justify-between gap-6 py-6 border-b border-slate-200">
    <div class="space-y-2 max-w-xl">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Takeda Log
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        日々のWeb開発・技術知見、旅行記やおすすめスポット、日常の思考を思いのままに発信する個人ブログです。
      </p>
    </div>

    <!-- カテゴリクイックアクセス -->
    <div class="mt-4 sm:mt-0 flex sm:flex-col gap-2 justify-center">
      <a
        href="/category/tech"
        class="px-4 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold text-xs border border-blue-200 flex items-center justify-between gap-3 transition-colors"
      >
        <span>💻 Tech 記事</span>
        <span class="bg-blue-200 text-blue-800 text-[10px] px-2 py-0.5 rounded-full">{techCount}</span>
      </a>
      <a
        href="/category/other"
        class="px-4 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold text-xs border border-emerald-200 flex items-center justify-between gap-3 transition-colors"
      >
        <span>☕ Other 記事 (旅・日常)</span>
        <span class="bg-emerald-200 text-emerald-800 text-[10px] px-2 py-0.5 rounded-full">{otherCount}</span>
      </a>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- メイン：記事一覧 -->
    <div class="lg:col-span-2 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <span>📝</span>
          <span>最新の記事 ({allPosts.length})</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5">
        {allPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>

    <!-- サイドバー -->
    <aside class="space-y-6">
      <!-- タグ一覧 -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-800 text-sm mb-3 flex items-center gap-2">
          <span>🏷️</span>
          <span>人気のタグ</span>
        </h3>
        <div class="flex flex-wrap gap-1.5">
          {allTags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-brand-50 hover:text-brand-700 text-slate-600 transition-colors border border-slate-200/60"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>

      <!-- スポンサー・広告枠 -->
      <AdSlot title="スポンサーリンク" className="my-0" />
    </aside>
  </div>
</BaseLayout>
