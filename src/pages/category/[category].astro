---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';

export async function getStaticPaths() {
  const categories = ['tech', 'other'] as const;
  const allPosts = await getCollection('blog');

  return categories.map((cat) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.category === cat)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: cat },
      props: { posts: filteredPosts, category: cat, allCategoryPosts: allPosts },
    };
  });
}

const { category } = Astro.params;
const { posts } = Astro.props;

// Otherカテゴリ内のタグ一覧を取得（TravelやGadgetなどのサブジャンル絞り込み用）
const subTags = category === 'other' ? [...new Set(posts.flatMap((p) => p.data.tags))] : [];

const categoryInfo = {
  tech: {
    title: '💻 Tech（技術記事）',
    description: 'Webフロントエンド開発、バックエンド、ツールや日々の開発知見に関する記事一覧です。',
    color: 'text-blue-700 bg-blue-50 border-blue-200',
  },
  other: {
    title: '☕ Other（旅・日常・雑記）',
    description: '旅行記、おすすめスポット、ガジェット、日常の雑記や思考メモなど、思いのままに綴る記事一覧です。',
    color: 'text-emerald-700 bg-emerald-50 border-emerald-200',
  },
}[category as 'tech' | 'other'];
---

<BaseLayout title={categoryInfo.title} description={categoryInfo.description}>
  <div class="space-y-8">
    <header class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
      <div class="flex items-center gap-2">
        <span class={`text-xs font-bold px-3 py-1 rounded-full border ${categoryInfo.color}`}>
          Category
        </span>
        <span class="text-xs text-slate-500">{posts.length} 件の記事</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
        {categoryInfo.title}
      </h1>
      <p class="text-slate-600 text-sm">
        {categoryInfo.description}
      </p>

      {subTags.length > 0 && (
        <div class="pt-3 flex flex-wrap items-center gap-1.5 border-t border-slate-100">
          <span class="text-xs text-slate-500 font-medium">ジャンル/タグ:</span>
          {subTags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 text-slate-600 transition-colors border border-slate-200/60"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-12 text-slate-500">
        まだ記事がありません。
      </div>
    )}
  </div>
</BaseLayout>
