---
interface PhotoItem {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  photos: PhotoItem[];
  columns?: 2 | 3;
}

const { photos, columns = 2 } = Astro.props;

const gridColsClass = columns === 3 ? 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2';
---

<div class={`my-8 grid ${gridColsClass} gap-4`}>
  {photos.map((photo) => (
    <figure class="group overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm transition-all hover:shadow-md">
      <div class="aspect-[4/3] overflow-hidden bg-slate-100 flex items-center justify-center">
        <img
          src={photo.src}
          alt={photo.alt}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
      {photo.caption && (
        <figcaption class="p-2.5 text-center text-xs text-slate-500 font-medium">
          {photo.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>
