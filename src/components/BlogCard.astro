---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, tags, isAffiliate } = post.data;

const formattedDate = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);

const categoryBadge =
  category === 'tech'
    ? { text: '💻 Tech', class: 'bg-blue-50 text-blue-700 border-blue-200' }
    : { text: '✈️ Travel', class: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
---

<article class="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class={`text-xs font-semibold px-2.5 py-0.5 rounded-full border ${categoryBadge.class}`}>
          {categoryBadge.text}
        </span>
        {isAffiliate && (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">
            PR
          </span>
        )}
      </div>
      <time datetime={pubDate.toISOString()} class="text-xs text-slate-400">
        {formattedDate}
      </time>
    </div>

    <h3 class="font-bold text-lg sm:text-xl text-slate-900 leading-snug mb-2 group">
      <a href={`/blog/${post.slug}`} class="hover:text-brand-600 transition-colors">
        {title}
      </a>
    </h3>

    <p class="text-slate-600 text-sm line-clamp-2 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <a
          href={`/tags/${tag}`}
          class="text-xs text-slate-500 hover:text-brand-600 hover:bg-slate-100 px-2 py-0.5 rounded transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>

    <a
      href={`/blog/${post.slug}`}
      class="text-xs font-semibold text-brand-600 hover:text-brand-700 flex items-center gap-1"
    >
      読む <span>→</span>
    </a>
  </div>
</article>
