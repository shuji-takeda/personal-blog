---
interface LinkItem {
  label: string;
  url: string;
  primary?: boolean;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  badge?: string;
  links: LinkItem[];
}

const { title, description, image, badge = 'おすすめアイテム', links } = Astro.props;
---

<div class="my-8 rounded-xl border border-slate-200 bg-gradient-to-br from-white to-slate-50 p-5 shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-center gap-2 mb-3">
    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200">
      {badge}
    </span>
    <span class="text-xs text-slate-400">※PR・プロモーションリンク</span>
  </div>

  <div class="flex flex-col sm:flex-row gap-5 items-start">
    {image && (
      <div class="w-full sm:w-36 h-36 flex-shrink-0 rounded-lg overflow-hidden border border-slate-200 bg-white flex items-center justify-center p-2">
        <img src={image} alt={title} class="max-h-full max-w-full object-contain" loading="lazy" />
      </div>
    )}

    <div class="flex-1 space-y-2">
      <h4 class="font-bold text-slate-900 text-base leading-snug">
        {title}
      </h4>
      {description && (
        <p class="text-slate-600 text-sm leading-relaxed">
          {description}
        </p>
      )}

      <!-- ボタンリンク群 -->
      <div class="pt-3 flex flex-wrap gap-2.5">
        {links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class={`px-4 py-2 rounded-lg text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 ${
              link.primary
                ? 'bg-amber-500 hover:bg-amber-600 text-white shadow-amber-200 hover:shadow-amber-300'
                : 'bg-white hover:bg-slate-100 text-slate-700 border border-slate-300'
            }`}
          >
            <span>{link.label}</span>
            <span class="text-[10px]">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
