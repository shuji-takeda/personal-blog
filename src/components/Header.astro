---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/category/tech', label: 'Tech' },
  { href: '/category/other', label: 'Other' },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/90 border-b border-slate-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- ロゴ / サイト名 -->
    <a href="/" class="flex items-center gap-2.5 group">
      <!-- MacBookアイコン（MITライセンス / 個人・商用利用可能） -->
      <svg
        class="w-6 h-6 text-slate-800 group-hover:text-brand-600 transition-colors"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"></path>
        <path d="M2 19h20a1 1 0 0 0 1-1v-1a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1Z"></path>
        <path d="M10 16h4"></path>
      </svg>
      <span class="font-bold text-xl text-slate-900 group-hover:text-brand-600 transition-colors">
        Takeshu Life &amp; Tech
      </span>
    </a>

    <!-- ナビゲーション -->
    <nav class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
              isActive
                ? 'bg-brand-50 text-brand-700 font-semibold'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
